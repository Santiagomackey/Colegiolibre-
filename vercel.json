{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/admin$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/moderacion$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/mensajes$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/perfil$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/publicar$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/analytics$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/beta\\-admin$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/auth\\-callback$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/recovery\\-callback$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/api(?:/.*)?$",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/service\\-worker\\.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://riqhwmszshleyyaxlwqu.supabase.co wss://riqhwmszshleyyaxlwqu.supabase.co https://*.googleapis.com https://fcmregistrations.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), microphone=(), geolocation=(), payment=()",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      },
      "continue": true
    },
    {
      "src": "^/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://riqhwmszshleyyaxlwqu.supabase.co wss://riqhwmszshleyyaxlwqu.supabase.co https://*.googleapis.com https://fcmregistrations.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), microphone=(), geolocation=(), payment=()",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      },
      "continue": true
    },
    {
      "src": "^/compra$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/pedidos$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/mp\\-vinculado$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/(?!api(?:/|$)|\\.well-known(?:/|$))(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?colegiolibre\\.com"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://www.colego.com.ar/$1"
      }
    },
    {
      "src": "^/(?:index(?:\\.html)?)?$",
      "dest": "/inicio-materiales.html"
    },
    {
      "src": "^/(busco|explorar|producto|publicar|colegio|login|perfil|mensajes|favoritos|pedidos|auth-callback|recovery-callback|compra|reportar|perfil-publico|mp-vinculado|portal-colegio|instituciones|ayuda|seguridad|terminos|privacidad|solicitar-portal)/?$",
      "dest": "/$1.html"
    },
    {
      "src": "^/(busco|explorar|producto|publicar|colegio|login|perfil|mensajes|favoritos|pedidos|auth-callback|recovery-callback|compra|reportar|perfil-publico|mp-vinculado|portal-colegio|instituciones|ayuda|seguridad|terminos|privacidad|solicitar-portal)\\.html$",
      "dest": "/$1.html"
    },
    {
      "src": "^/(?:[a-z0-9_-]+-school|colegio-[a-z0-9_-]+|comunidad/[a-z0-9_-]+)(?:/editor)?/?$",
      "dest": "/portal-colegio.html"
    },
    {
      "src": "^/colegio/[a-z0-9_-]+/?$",
      "dest": "/colegio.html"
    },
    {
      "src": "^/(?!api(?:/|$)|\\.well-known(?:/|$))(?:[^.]*|.*\\.html?)$",
      "dest": "/pagina-en-blanco.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
