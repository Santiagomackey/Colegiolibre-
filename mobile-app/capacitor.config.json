{
  "appId": "com.colegiolibre.app",
  "appName": "ColegioLibre",
  "webDir": "www",
  "server": {
    "url": "https://www.colegiolibre.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "www.colegiolibre.com",
      "colegiolibre.com"
    ]
  },
  "plugins": {
    "Camera": {
      "allowEditing": false,
      "saveToGallery": false
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFF",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_colegiolibre",
      "iconColor": "#0B2E6B"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
