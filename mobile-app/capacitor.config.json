{
  "appId": "com.colegiolibre.app",
  "appName": "ColegioLibre",
  "webDir": "www",
  "server": {
    "url": "https://colegiolibre.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "colegiolibre.com",
      "www.colegiolibre.com",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "Camera": {
      "allowEditing": false,
      "saveToGallery": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_launcher_foreground",
      "iconColor": "#67C23A"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
